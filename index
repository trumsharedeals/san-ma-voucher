<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Săn Mã Voucher Grab 11.11</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-gray-100 min-h-screen pb-10">

  <!-- Header -->
  <header class="bg-green-600 text-white py-6 shadow-md mb-6">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-2xl sm:text-3xl font-bold">🎉 TỔNG HỢP MÃ VOUCHER GRAB</h1>
      <p class="text-green-100 text-sm mt-1">Cập nhật real-time | Sao chép 1-click</p>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-3xl mx-auto px-4">
    <!-- Nút Làm Mới -->
    <div class="flex justify-between items-center mb-4">
      <span id="total-count" class="text-gray-600 text-sm font-medium">Đang tải mã...</span>
      <button onclick="fetchVouchers()" class="bg-white border border-gray-300 text-gray-700 text-xs px-3 py-1.5 rounded-lg shadow-sm hover:bg-gray-50 flex items-center gap-1 transition">
        🔄 Làm mới
      </button>
    </div>

    <!-- Danh sách Voucher -->
    <div id="voucher-list" class="space-y-4">
      <!-- Loading Skeleton -->
      <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200 animate-pulse flex flex-col gap-2">
        <div class="h-5 bg-gray-200 rounded w-1/3"></div>
        <div class="h-4 bg-gray-200 rounded w-2/3"></div>
      </div>
    </div>
  </main>

  <!-- Thông báo Copy Toast -->
  <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs px-4 py-2 rounded-full shadow-lg transition-opacity duration-300 opacity-0 pointer-events-none">
    Đã sao chép mã!
  </div>

  <script>
    // Link API Google Apps Script của bạn
    const API_URL = "https://script.google.com/macros/s/AKfycbyL0kRhKfa0RL8TTpDQgVOd_rzIq-zvQVLp7diFX-ij4oMuDXq41Xikrdt7h7u3qJUy/exec";

    async function fetchVouchers() {
      const container = document.getElementById('voucher-list');
      const countEl = document.getElementById('total-count');
      
      try {
        const response = await fetch(API_URL);
        const result = await response.json();

        if (result.success && result.data.length > 0) {
          countEl.innerText = `Tìm thấy ${result.data.length} mã đang hoạt động`;
          container.innerHTML = result.data.map(item => renderVoucherCard(item)).join('');
        } else {
          countEl.innerText = 'Không có mã nào';
          container.innerHTML = `<div class="bg-white text-center py-8 rounded-xl text-gray-500">Chưa có mã voucher nào được bật.</div>`;
        }
      } catch (error) {
        countEl.innerText = 'Lỗi tải dữ liệu';
        container.innerHTML = `<div class="bg-red-50 text-red-600 text-center py-6 rounded-xl border border-red-200">Không thể kết nối đến Google Sheet. Bạn vui lòng thử lại sau!</div>`;
      }
    }

    function renderVoucherCard(item) {
      const isAvailable = item.status.toLowerCase() === 'còn';
      const statusBadge = isAvailable 
        ? `<span class="bg-green-100 text-green-700 text-xs font-semibold px-2.5 py-0.5 rounded">Còn lượt</span>`
        : `<span class="bg-red-100 text-red-600 text-xs font-semibold px-2.5 py-0.5 rounded">Hết lượt</span>`;

      return `
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 hover:shadow-md transition">
          <div class="flex items-center justify-between gap-2 border-b border-gray-100 pb-3 mb-3">
            <div class="flex items-center gap-2">
              <span class="font-mono text-lg font-bold text-gray-900 tracking-wide">${item.code}</span>
              ${statusBadge}
            </div>
            <button onclick="copyCode('${item.code}')" class="bg-green-600 hover:bg-green-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm transition active:scale-95">
              Copy Mã
            </button>
          </div>

          <div class="grid grid-cols-2 gap-2 text-xs text-gray-600 mb-2">
            <div>📍 <span class="font-medium text-gray-800">Khu vực:</span> ${item.applyAt || 'Tất cả'}</div>
            <div>🍽️ <span class="font-medium text-gray-800">Dịch vụ:</span> ${item.applyFor || 'Grab'}</div>
          </div>

          ${item.note ? `<div class="text-xs text-amber-700 bg-amber-50 p-2 rounded-md mb-2">📌 <b>Ghi chú:</b> ${item.note}</div>` : ''}
          ${item.publishTime ? `<div class="text-[11px] text-gray-400 text-right">⏰ Khung giờ: ${item.publishTime}</div>` : ''}
        </div>
      `;
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code);
      const toast = document.getElementById('toast');
      toast.classList.remove('opacity-0');
      setTimeout(() => toast.classList.add('opacity-0'), 2000);
    }

    // Tự động tải dữ liệu khi mở trang
    fetchVouchers();
  </script>
</body>
</html>
